#include <iostream>
#include <vector>
using namespace std;

int knapsack(vector<int> &weights, vector<int> &profits, int capacity) {
    int n = weights.size();
    vector<vector<int>> dp(n + 1, vector<int>(capacity + 1, 0));

    for (int i = 1; i <= n; i++) {
        for (int w = 1; w <= capacity; w++) {
            if (weights[i - 1] <= w) {
                dp[i][w] = max(dp[i - 1][w], profits[i - 1] + dp[i - 1][w - weights[i - 1]]);
            } else {
                dp[i][w] = dp[i - 1][w];
            }
        }
    }
    return dp[n][capacity];
}

int main() {
    vector<int> weights = {1, 2, 3}; // Weights of items
    vector<int> profits = {10, 15, 40}; // Profits of items
    int capacity = 6; // Maximum weight capacity
    cout << "Maximum profit: " << knapsack(weights, profits, capacity) << "\n";
    return 0;
}
